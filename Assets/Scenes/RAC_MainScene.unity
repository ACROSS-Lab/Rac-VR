  preFillRectList: []
  preFillStringList:
  - "Xin ch\xE0o ! "
  - "Hi\u1EC7n nay, l\u01B0\u1EE3ng r\xE1c th\u1EA3i tr\xEAn m\u1EB7t \u0111\u1EA5t
    v\xE0 d\xF2ng s\xF4ng \u0111\xE3 t\u0103ng l\xEAn."
  - " \u0110i\u1EC1u n\xE0y \u0111\xE3 tr\u1EDF n\xEAn qu\xE1 m\u1EE9c ch\u1ECBu
    \u0111\u1EF1ng ! Kh\xF4ng ai l\xE0m g\xEC \u0111\u1EC3 thay \u0111\u1ED5i vi\u1EC7c
    n\xE0y c\u1EA3, t\u1EEB c\xE1c ch\xEDnh tr\u1ECB gia, c\xE1c nh\xE0 l\xE3nh \u0111\u1EA1o,
    \u0111\u1EBFn ng\u01B0\u1EDDi d\xE2n \u2026"
  - "B\u1EA1n c\xF3 th\u1EC3 nh\u1EB7t r\xE1c tr\xEAn m\u1EB7t \u0111\u1EA5t v\xE0
    tr\xEAn s\xF4ng kh\xF4ng, c\xF3 th\u1EC3 vi\u1EC7c n\xE0y s\u1EBD gi\xFAp thay
    \u0111\u1ED5i c\u1ED9ng \u0111\u1ED3ng ? "
  - "T\xF4i c\u1EA7n b\u1EA1n nh\u1EB7t 20 r\xE1c, h\xE3y ch\u1ECDn n\u01A1i b\u1EA1n
    mu\u1ED1n d\u1ECDn d\u1EB9p !"
  - 
  preFillTextureList: []
  preFillVector2List: []
  preFillVector3List: []
